# OpenRouter API Key
# 실제 키는 .env.local 또는 Vercel Environment Variables에 설정합니다.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# OpenRouter에서 사용할 모델 ID
# 필요하면 나중에 server.ts의 OPENROUTER_MODEL 값과 맞춰 사용합니다.
OPENROUTER_MODEL="openai/gpt-oss-20b"

# App URL
# 로컬 또는 배포된 포트폴리오 주소
APP_URL="http://localhost:3000"